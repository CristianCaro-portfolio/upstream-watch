# Everything is optional. Defaults run fully offline on a laptop CPU.
UPW_DATA_DIR=./data
UPW_REPORTS_DIR=./reports
# fastembed (BAAI/bge-small-en-v1.5) or hash (no download, used in CI)
UPW_EMBEDDER=fastembed
# rule (deterministic), local (transformers on CPU), ollama, openai
UPW_LLM_PROVIDER=rule
UPW_LLM_MODEL=qwen2.5:1.5b-instruct
UPW_LLM_BASE_URL=http://localhost:11434
UPW_LLM_API_KEY=your-key-here
# Optional api.waterdata.usgs.gov key, raises the anonymous rate limit
UPW_USGS_API_KEY=your-key-here
UPW_TOP_K=8
UPW_OTEL_CONSOLE=0
